// two 'Busy' threads on their own CPU for 15s, one with priority boost and one without
//
// 'Busy' works 75% of each 100ms period and waits the rest (keep thread-sim in FG to get the boost, if not disabled via PsPrioritySeparation)
// Windows raises the current priority of a thread in the FG process when its wait ends

{
  "format": "thread-sim.run-config",
  "name": "Priority boosting",
  "duration_s": 15,
  "sample_interval_ms": 500,
  "threads": [
    {
      "name": "Boost on",
      "active": true,
      "shared_mutex": false,
      "scheduling": {
        "relative_priority": "normal",
        "priority_boost_enabled": true
      },
      "affinity": {
        "mode": "group_affinity",
        "group_affinity_group": 0,
        "group_affinity_processors": [
          2
        ],
        "selected_cpu_set_ids": [],
        "ideal_processor": null
      },
      "activity": {
        "work_percent": 75,
        "period_ms": 100,
        "waitable_timer_kind": "default"
      }
    },
    {
      "name": "Boost off",
      "active": true,
      "shared_mutex": false,
      "scheduling": {
        "relative_priority": "normal",
        "priority_boost_enabled": false
      },
      "affinity": {
        "mode": "group_affinity",
        "group_affinity_group": 0,
        "group_affinity_processors": [
          3
        ],
        "selected_cpu_set_ids": [],
        "ideal_processor": null
      },
      "activity": {
        "work_percent": 75,
        "period_ms": 100,
        "waitable_timer_kind": "default"
      }
    }
  ]
}
