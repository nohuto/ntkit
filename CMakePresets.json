{
  "version": 9,
  "configurePresets": [
    {
      "name": "vs2022",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release;Debug"
      }
    },
    {
      "name": "x64-release",
      "inherits": "vs2022",
      "architecture": "x64"
    },
    {
      "name": "x64-dev",
      "displayName": "x64 Dev (local win32-ui, dev test hooks)",
      "inherits": "x64-release",
      "cacheVariables": {
        "THREAD_SIM_DEV": "ON",
        "FETCHCONTENT_SOURCE_DIR_WIN32UI": "${sourceDir}/../win32-ui"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release"
    },
    {
      "name": "x64-dev",
      "configurePreset": "x64-dev",
      "configuration": "Release"
    }
  ]
}
