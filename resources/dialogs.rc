

IDD_ACTIVITY DIALOGEX 0, 0, 214, 101
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Activity"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Work", IDC_ACTIVITY_WORK_LABEL, 7, 8, 42, 8, SS_NOPREFIX
    EDITTEXT        IDC_ACTIVITY_WORK_EDIT, 54, 6, 37, 11, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "%", IDC_ACTIVITY_WORK_UNIT, 95, 8, 20, 8, SS_NOPREFIX
    LTEXT           "Period", IDC_ACTIVITY_PERIOD_LABEL, 7, 23, 42, 8, SS_NOPREFIX
    EDITTEXT        IDC_ACTIVITY_PERIOD_EDIT, 54, 21, 37, 11, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "ms", IDC_ACTIVITY_PERIOD_UNIT, 95, 23, 20, 8, SS_NOPREFIX
    LTEXT           "Wake by", IDC_ACTIVITY_WAKE_LABEL, 7, 38, 42, 8, SS_NOPREFIX
    COMBOBOX        IDC_ACTIVITY_WAKE_COMBO, 54, 36, 86, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Wait timer", IDC_ACTIVITY_TIMER_LABEL, 7, 53, 42, 8, SS_NOPREFIX
    COMBOBOX        IDC_ACTIVITY_TIMER_COMBO, 54, 51, 86, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Start delay", IDC_ACTIVITY_DELAY_LABEL, 7, 68, 42, 8, SS_NOPREFIX
    EDITTEXT        IDC_ACTIVITY_DELAY_EDIT, 54, 66, 37, 11, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "ms", IDC_ACTIVITY_DELAY_UNIT, 95, 68, 20, 8, SS_NOPREFIX
    DEFPUSHBUTTON   "OK", IDOK, 119, 83, 40, 11
    PUSHBUTTON      "Cancel", IDCANCEL, 165, 83, 40, 11
END

