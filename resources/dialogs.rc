IDD_PROCESSOR_PICKER DIALOGEX 0, 0, 366, 210
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "Processors"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Processor group", IDC_PICKER_GROUP_LABEL, 7, 8, 50, 8, SS_NOPREFIX
    COMBOBOX        IDC_PICKER_GROUP_COMBO, 62, 6, 137, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Processors", IDC_PICKER_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_TABSTOP, 7, 21, 352, 143
    LTEXT           "", IDC_PICKER_VALIDATION, 7, 169, 352, 8, SS_NOPREFIX
    LTEXT           "", IDC_PICKER_WARNINGS, 7, 178, 352, 8, SS_NOPREFIX
    PUSHBUTTON      "Select &all", IDC_PICKER_SELECT_ALL, 7, 192, 40, 11
    PUSHBUTTON      "C&lear", IDC_PICKER_CLEAR, 53, 192, 40, 11
    DEFPUSHBUTTON   "OK", IDOK, 271, 192, 40, 11
    PUSHBUTTON      "Cancel", IDCANCEL, 317, 192, 40, 11
END

IDD_DETAILS DIALOGEX 0, 0, 571, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "Details"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "Thread details", IDC_DETAILS_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_TABSTOP, 7, 6, 558, 206
END

IDD_TEXT_PROMPT DIALOGEX 0, 0, 220, 41
