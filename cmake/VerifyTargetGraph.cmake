function(thread_sim_verify_layers)
    set(layers)
    foreach(entry IN LISTS ARGN)
        string(REPLACE ":" ";" parts "${entry}")
        list(GET parts 0 layer)
        list(LENGTH parts count)
        set(allowed)
        if (count GREATER 1)
            list(GET parts 1 allowed)
            string(REPLACE "," ";" allowed "${allowed}")
        endif()
        list(APPEND layers ${layer})
        set(allowed_${layer} ${allowed})
    endforeach()

    set(errors)
    file(GLOB children LIST_DIRECTORIES true "${PROJECT_SOURCE_DIR}/src/*")
    foreach(child IN LISTS children)
        if (IS_DIRECTORY "${child}")
            get_filename_component(folder "${child}" NAME)
            if (NOT folder IN_LIST layers)
                list(APPEND errors "src/${folder} has no layer entry")
            endif()
        endif()
    endforeach()

    foreach(layer IN LISTS layers)
        if (layer STREQUAL "app")
            set(target thread-sim)
        else()
            set(target thread_sim_${layer})
        endif()
        if (NOT TARGET ${target})
            list(APPEND errors "layer ${layer} has no target ${target}")
            continue()
        endif()
        get_target_property(links ${target} LINK_LIBRARIES)
        get_target_property(interface_links ${target} INTERFACE_LINK_LIBRARIES)
        foreach(dependency IN LISTS links interface_links)
            if (dependency MATCHES "^\\$<LINK_ONLY:([^$<>]+)>$")
                set(dependency "${CMAKE_MATCH_1}")
            endif()
            if (dependency MATCHES "NOTFOUND$" OR dependency STREQUAL "thread_sim_compile_settings")
                continue()
            endif()
            if (dependency MATCHES "\\$<" AND dependency MATCHES "thread[-_]sim")
                list(APPEND errors "${target}: project targets must be linked without generator expressions (${dependency})")
            elseif (dependency MATCHES "^thread_sim_(.+)$")
                if (NOT CMAKE_MATCH_1 IN_LIST allowed_${layer})
                    list(APPEND errors "${target} links ${dependency}, ${layer} may use: ${allowed_${layer}}")
                endif()
            endif()
        endforeach()

        file(GLOB_RECURSE sources CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/src/${layer}/*.h" "${PROJECT_SOURCE_DIR}/src/${layer}/*.cpp")
        foreach(source IN LISTS sources)
            file(STRINGS "${source}" includes REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"][a-z0-9_]+/")
            foreach(line IN LISTS includes)
                string(REGEX MATCH "[<\"]([a-z0-9_]+)/" match "${line}")
                set(included "${CMAKE_MATCH_1}")
                if (included IN_LIST layers AND NOT included STREQUAL layer AND NOT included IN_LIST allowed_${layer})
                    file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${source}")
                    list(APPEND errors "${relative}: ${line}")
                endif()
            endforeach()
        endforeach()
    endforeach()

    file(GLOB_RECURSE engine_sources CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/src/engine/*.h" "${PROJECT_SOURCE_DIR}/src/engine/*.cpp")
    foreach(source IN LISTS engine_sources)
        file(STRINGS "${source}" ui_tokens REGEX "(HWND|commctrl\\.h|uxtheme\\.h|PostMessage|SendMessage)")
        if (ui_tokens)
            file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${source}")
            list(APPEND errors "${relative}: engine code references window APIs")
        endif()
    endforeach()

    if (errors)
        list(JOIN errors "\n" errors)
        message(FATAL_ERROR "Layering violations:\n${errors}")
    endif()
endfunction()
