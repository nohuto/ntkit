// two 'Maximum' threads share logical CPU 1 for 30s
//
// use 'Normal' process priority, 'Normal' then has base priority 8 and 'Lowest' has base priority 6
// after startup neither worker waits, 'Lowest' stays ready for long intervals while 'Normal' runs
// Windows can then temporarily boost a starved worker so it gets time

{
  "format": "thread-sim.run-config",
  "name": "CPU starvation",
  "duration_s": 30,
  "sample_interval_ms": 500,
  "threads": [
    {
      "name": "Normal",
      "active": true,
      "shared_mutex": false,
      "scheduling": {
        "relative_priority": "normal",
        "priority_boost_enabled": true
      },
      "affinity": {
        "mode": "group_affinity",
        "group_affinity_group": 0,
        "group_affinity_processors": [
          1
        ],
        "selected_cpu_set_ids": [],
        "ideal_processor": null
      },
      "activity": {
        "work_percent": 100,
        "period_ms": 100,
        "waitable_timer_kind": "default"
      }
    },
    {
      "name": "Lowest",
      "active": true,
      "shared_mutex": false,
      "scheduling": {
        "relative_priority": "lowest",
        "priority_boost_enabled": true
      },
      "affinity": {
        "mode": "group_affinity",
        "group_affinity_group": 0,
        "group_affinity_processors": [
          1
        ],
        "selected_cpu_set_ids": [],
        "ideal_processor": null
      },
      "activity": {
        "work_percent": 100,
        "period_ms": 100,
        "waitable_timer_kind": "default"
      }
    }
  ]
}
