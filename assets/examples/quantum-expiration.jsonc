// two 'Maximum' threads of the same priority share logical CPU 1 for 10s, with dynamic boosts disabled
//
// use 'Normal' process priority, both workers then have base priority 8
// after startup neither worker waits, so quantum expiration lets the other ready worker run

{
  "format": "thread-sim.run-config",
  "name": "Quantum expiration",
  "duration_s": 10,
  "sample_interval_ms": 500,
  "threads": [
    {
      "name": "First",
      "active": true,
      "shared_mutex": false,
      "scheduling": {
        "relative_priority": "normal",
        "priority_boost_enabled": false
      },
      "affinity": {
        "mode": "group_affinity",
        "group_affinity_group": 0,
        "group_affinity_processors": [
          1
        ],
        "selected_cpu_set_ids": [],
        "ideal_processor": null
      },
      "activity": {
        "work_percent": 100,
        "period_ms": 100,
        "waitable_timer_kind": "default"
      }
    },
    {
      "name": "Second",
      "active": true,
      "shared_mutex": false,
      "scheduling": {
        "relative_priority": "normal",
        "priority_boost_enabled": false
      },
      "affinity": {
        "mode": "group_affinity",
        "group_affinity_group": 0,
        "group_affinity_processors": [
          1
        ],
        "selected_cpu_set_ids": [],
        "ideal_processor": null
      },
      "activity": {
        "work_percent": 100,
        "period_ms": 100,
        "waitable_timer_kind": "default"
      }
    }
  ]
}
