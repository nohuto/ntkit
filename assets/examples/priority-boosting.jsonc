// two 'Busy' threads on separate logical CPUs for 15s, one with priority boost and one without
//
// use 'Normal' process priority and keep thread-sim in the FG, with PsPrioritySeparation > 0 
// each worker works in the first 75ms of each 100ms period and waits on a timer for the next period

{
  "format": "thread-sim.run-config",
  "name": "Priority boosting",
  "duration_s": 15,
  "sample_interval_ms": 500,
  "threads": [
    {
      "name": "Boost on",
      "active": true,
      "shared_mutex": false,
      "scheduling": {
        "relative_priority": "normal",
        "priority_boost_enabled": true
      },
      "affinity": {
        "mode": "group_affinity",
        "group_affinity_group": 0,
        "group_affinity_processors": [
          2
        ],
        "selected_cpu_set_ids": [],
        "ideal_processor": null
      },
      "activity": {
        "work_percent": 75,
        "period_ms": 100,
        "waitable_timer_kind": "default"
      }
    },
    {
      "name": "Boost off",
      "active": true,
      "shared_mutex": false,
      "scheduling": {
        "relative_priority": "normal",
        "priority_boost_enabled": false
      },
      "affinity": {
        "mode": "group_affinity",
        "group_affinity_group": 0,
        "group_affinity_processors": [
          3
        ],
        "selected_cpu_set_ids": [],
        "ideal_processor": null
      },
      "activity": {
        "work_percent": 75,
        "period_ms": 100,
        "waitable_timer_kind": "default"
      }
    }
  ]
}
