// 'Background' (Normal, Maximum) and 'Periodic' (Highest, Low) share logical CPU 1 for 10s, with dynamic boosts disabled
//
// use 'Normal' process priority, 'Background' then has base priority 8 and 'Periodic' has base priority 10
// when 'Periodic' becomes ready it can preempt 'Background', which continues when 'Periodic' waits
// 'Periodic' works in the first 25ms of each 100ms period, delayed execution reduces the work it can finish

{
  "format": "thread-sim.run-config",
  "name": "Priority preemption",
  "duration_s": 10,
  "sample_interval_ms": 500,
  "threads": [
    {
      "name": "Background",
      "active": true,
      "shared_mutex": false,
      "scheduling": {
        "relative_priority": "normal",
        "priority_boost_enabled": false
      },
      "affinity": {
        "mode": "group_affinity",
        "group_affinity_group": 0,
        "group_affinity_processors": [
          1
        ],
        "selected_cpu_set_ids": [],
        "ideal_processor": null
      },
      "activity": {
        "work_percent": 100,
        "period_ms": 100,
        "waitable_timer_kind": "default"
      }
    },
    {
      "name": "Periodic",
      "active": true,
      "shared_mutex": false,
      "scheduling": {
        "relative_priority": "highest",
        "priority_boost_enabled": false
      },
      "affinity": {
        "mode": "group_affinity",
        "group_affinity_group": 0,
        "group_affinity_processors": [
          1
        ],
        "selected_cpu_set_ids": [],
        "ideal_processor": null
      },
      "activity": {
        "work_percent": 25,
        "period_ms": 100,
        "waitable_timer_kind": "high_resolution"
      }
    }
  ]
}
